# 本地配置示例；自己的 Key 仅放入 .env。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=800
LLM_THINKING=disabled
RUNTIME_MAX_STEPS=8
RUNTIME_MAX_CONTEXT_CHARS=48000
RUNTIME_MAX_REQUESTS_PER_SESSION=500

# 语音转写。配置后重启服务。凭据只放本地 .env。
ASR_PROVIDER=disabled
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_TOKEN=
ASR_ENGINE=16k_zh
ASR_TIMEOUT_SECONDS=20
ASR_MAX_CONCURRENT=2
ASR_MAX_REQUESTS=100
ASR_CACHE_SECONDS=600
