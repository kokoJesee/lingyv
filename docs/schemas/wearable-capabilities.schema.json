{
  "$defs": {
    "MetricCapability": {
      "additionalProperties": false,
      "properties": {
        "metric_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "supported": {
          "title": "Supported",
          "type": "boolean"
        },
        "unit": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "measurement_method": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Measurement Method",
          "type": "string"
        },
        "aggregation_method": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Aggregation Method",
          "type": "string"
        },
        "sample_interval_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Interval Seconds"
        },
        "score_scale": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScoreScale"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "metric_id",
        "supported",
        "unit",
        "measurement_method",
        "aggregation_method"
      ],
      "title": "MetricCapability",
      "type": "object"
    },
    "ScoreScale": {
      "additionalProperties": false,
      "properties": {
        "minimum": {
          "title": "Minimum",
          "type": "number"
        },
        "maximum": {
          "title": "Maximum",
          "type": "number"
        },
        "direction": {
          "enum": [
            "higher_is_more",
            "higher_is_less",
            "unspecified"
          ],
          "title": "Direction",
          "type": "string"
        }
      },
      "required": [
        "minimum",
        "maximum",
        "direction"
      ],
      "title": "ScoreScale",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "capability_profile": {
      "enum": [
        "mock_basic_band",
        "mock_advanced_wearable",
        "mock_research_combined"
      ],
      "title": "Capability Profile",
      "type": "string"
    },
    "is_simulated": {
      "const": true,
      "default": true,
      "title": "Is Simulated",
      "type": "boolean"
    },
    "device_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Device Id",
      "type": "string"
    },
    "capabilities": {
      "items": {
        "$ref": "#/$defs/MetricCapability"
      },
      "maxItems": 30,
      "minItems": 30,
      "title": "Capabilities",
      "type": "array"
    }
  },
  "required": [
    "capability_profile",
    "device_id",
    "capabilities"
  ],
  "title": "DeviceCapabilities",
  "type": "object"
}
