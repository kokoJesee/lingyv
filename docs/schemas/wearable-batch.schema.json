{
  "$defs": {
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "wearable_record",
            "user_report",
            "understanding",
            "consent"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "source_id",
        "revision"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "MetricValue": {
      "additionalProperties": false,
      "properties": {
        "metric_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "value_type": {
          "enum": [
            "number",
            "integer",
            "timestamp"
          ],
          "title": "Value Type",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "measurement_kind": {
          "enum": [
            "sensor_estimate",
            "algorithm_estimate",
            "derived_statistic",
            "vendor_score"
          ],
          "title": "Measurement Kind",
          "type": "string"
        },
        "measurement_method": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Measurement Method",
          "type": "string"
        },
        "aggregation_method": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Aggregation Method",
          "type": "string"
        },
        "window": {
          "$ref": "#/$defs/TimeWindow"
        },
        "window_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window Seconds"
        },
        "source_algorithm_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source Algorithm Version",
          "type": "string"
        },
        "quality": {
          "enum": [
            "valid",
            "missing",
            "incomplete",
            "invalid",
            "unknown",
            "unsupported"
          ],
          "title": "Quality",
          "type": "string"
        },
        "quality_reasons": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Quality Reasons",
          "type": "array"
        },
        "coverage": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coverage"
        },
        "baseline_ref": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Ref"
        },
        "measurement_site": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measurement Site"
        },
        "namespace": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Namespace"
        },
        "score_scale": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScoreScale"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "score_origin": {
          "anyOf": [
            {
              "enum": [
                "fixture",
                "vendor"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score Origin"
        },
        "dependency_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "maxItems": 200,
          "title": "Dependency Refs",
          "type": "array"
        }
      },
      "required": [
        "metric_id",
        "value_type",
        "value",
        "unit",
        "measurement_kind",
        "measurement_method",
        "aggregation_method",
        "window",
        "source_algorithm_version",
        "quality"
      ],
      "title": "MetricValue",
      "type": "object"
    },
    "ScoreScale": {
      "additionalProperties": false,
      "properties": {
        "minimum": {
          "title": "Minimum",
          "type": "number"
        },
        "maximum": {
          "title": "Maximum",
          "type": "number"
        },
        "direction": {
          "enum": [
            "higher_is_more",
            "higher_is_less",
            "unspecified"
          ],
          "title": "Direction",
          "type": "string"
        }
      },
      "required": [
        "minimum",
        "maximum",
        "direction"
      ],
      "title": "ScoreScale",
      "type": "object"
    },
    "SleepEpisode": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "wearable.v0.1",
          "default": "wearable.v0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "record_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "record_revision": {
          "minimum": 1,
          "title": "Record Revision",
          "type": "integer"
        },
        "provider": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "provider_record_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Provider Record Id",
          "type": "string"
        },
        "device_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Device Id",
          "type": "string"
        },
        "is_simulated": {
          "title": "Is Simulated",
          "type": "boolean"
        },
        "timezone": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        },
        "observed_start": {
          "format": "date-time",
          "title": "Observed Start",
          "type": "string"
        },
        "observed_end": {
          "format": "date-time",
          "title": "Observed End",
          "type": "string"
        },
        "ingested_at": {
          "format": "date-time",
          "title": "Ingested At",
          "type": "string"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/MetricValue"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Metrics",
          "type": "array"
        },
        "record_type": {
          "const": "sleep",
          "default": "sleep",
          "title": "Record Type",
          "type": "string"
        },
        "sleep_kind": {
          "enum": [
            "main",
            "nap"
          ],
          "title": "Sleep Kind",
          "type": "string"
        },
        "local_date": {
          "format": "date",
          "title": "Local Date",
          "type": "string"
        },
        "sleep_onset_at": {
          "format": "date-time",
          "title": "Sleep Onset At",
          "type": "string"
        },
        "final_wake_at": {
          "format": "date-time",
          "title": "Final Wake At",
          "type": "string"
        },
        "stages_complete": {
          "title": "Stages Complete",
          "type": "boolean"
        },
        "stages": {
          "items": {
            "$ref": "#/$defs/SleepStage"
          },
          "maxItems": 1000,
          "title": "Stages",
          "type": "array"
        }
      },
      "required": [
        "record_id",
        "record_revision",
        "provider",
        "provider_record_id",
        "device_id",
        "is_simulated",
        "timezone",
        "observed_start",
        "observed_end",
        "ingested_at",
        "metrics",
        "sleep_kind",
        "local_date",
        "sleep_onset_at",
        "final_wake_at",
        "stages_complete"
      ],
      "title": "SleepEpisode",
      "type": "object"
    },
    "SleepStage": {
      "additionalProperties": false,
      "properties": {
        "stage": {
          "enum": [
            "deep",
            "rem",
            "light",
            "awake",
            "unknown"
          ],
          "title": "Stage",
          "type": "string"
        },
        "window": {
          "$ref": "#/$defs/TimeWindow"
        }
      },
      "required": [
        "stage",
        "window"
      ],
      "title": "SleepStage",
      "type": "object"
    },
    "TimeWindow": {
      "additionalProperties": false,
