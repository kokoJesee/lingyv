{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PsychologyRequest v0.1.0 (proposal, not runtime enabled)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "session_revision": {
      "type": "integer",
      "minimum": 0
    },
    "current_message": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "content": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_id",
        "content"
      ]
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "role": {
            "enum": [
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_id",
          "role",
          "content"
        ]
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "evidence_type": {
            "enum": [
              "user_report",
              "device_observation",
              "confirmed_memory",
              "hypothesis"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_id",
          "evidence_type",
          "content"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "request_id",
    "session_revision",
    "current_message",
    "history",
    "records"
  ]
}
