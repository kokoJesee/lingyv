{
  "$defs": {
    "DateWindow": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "DateWindow",
      "type": "object"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "wearable_record",
            "user_report",
            "understanding",
            "consent"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "source_id",
        "revision"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "MetricAvailability": {
      "additionalProperties": false,
      "properties": {
        "metric_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "ready",
            "not_authorized",
            "no_data",
            "baseline_insufficient",
            "recent_insufficient",
            "quality_insufficient",
            "source_conflict"
          ],
          "title": "Status",
          "type": "string"
        },
        "baseline_valid_days": {
          "minimum": 0,
          "title": "Baseline Valid Days",
          "type": "integer"
        },
        "recent_valid_days": {
          "minimum": 0,
          "title": "Recent Valid Days",
          "type": "integer"
        },
        "excluded_days": {
          "minimum": 0,
          "title": "Excluded Days",
          "type": "integer"
        }
      },
      "required": [
        "metric_id",
        "status",
        "baseline_valid_days",
        "recent_valid_days",
        "excluded_days"
      ],
      "title": "MetricAvailability",
      "type": "object"
    },
    "StateObservation": {
      "additionalProperties": false,
      "properties": {
        "metric_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "baseline_window": {
          "$ref": "#/$defs/DateWindow"
        },
        "recent_window": {
          "$ref": "#/$defs/DateWindow"
        },
        "baseline_valid_days": {
          "minimum": 1,
          "title": "Baseline Valid Days",
          "type": "integer"
        },
        "recent_valid_days": {
          "minimum": 1,
          "title": "Recent Valid Days",
          "type": "integer"
        },
        "baseline_median": {
          "title": "Baseline Median",
          "type": "number"
        },
        "recent_median": {
          "title": "Recent Median",
          "type": "number"
        },
        "delta": {
          "title": "Delta",
          "type": "number"
        },
        "relative_delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relative Delta"
        },
        "unit": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "comparison_method": {
          "enum": [
            "numeric_median",
            "sleep_day_relative_minutes"
          ],
          "title": "Comparison Method",
          "type": "string"
        },
        "provider": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "device_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Device Id",
          "type": "string"
        },
        "measurement_method": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Measurement Method",
          "type": "string"
        },
        "source_algorithm_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source Algorithm Version",
          "type": "string"
        },
        "baseline_ref": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Ref"
        },
        "timezone": {
          "default": "UTC",
          "maxLength": 256,
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        },
        "aggregation_method": {
          "default": "unspecified",
          "maxLength": 256,
          "minLength": 1,
          "title": "Aggregation Method",
          "type": "string"
        },
        "window_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window Seconds"
        },
        "measurement_site": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measurement Site"
        },
        "evidence_group": {
          "default": "sleep",
          "enum": [
            "sleep",
            "cardiovascular",
            "activity",
            "other_night"
          ],
          "title": "Evidence Group",
          "type": "string"
        },
        "inquiry_candidate": {
          "default": false,
          "title": "Inquiry Candidate",
          "type": "boolean"
        },
        "record_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Record Refs",
          "type": "array"
        }
      },
      "required": [
        "metric_id",
        "baseline_window",
        "recent_window",
        "baseline_valid_days",
        "recent_valid_days",
        "baseline_median",
        "recent_median",
        "delta",
        "unit",
        "comparison_method",
        "provider",
        "device_id",
        "measurement_method",
        "source_algorithm_version",
        "record_refs"
      ],
      "title": "StateObservation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "state_analysis.v0.1",
      "default": "state_analysis.v0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "analysis_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Analysis Id",
      "type": "string"
    },
    "session_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Id"
    },
    "evidence_revision": {
      "minimum": 0,
      "title": "Evidence Revision",
      "type": "integer"
    },
    "algorithm_version": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Algorithm Version",
      "type": "string"
    },
    "is_simulated": {
      "title": "Is Simulated",
      "type": "boolean"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "status": {
      "enum": [
        "ready",
        "insufficient_data",
        "not_authorized",
        "source_conflict"
      ],
      "title": "Status",
      "type": "string"
    },
    "scope": {
      "default": "local_analysis",
      "enum": [
        "local_analysis",
        "model_context"
      ],
      "title": "Scope",
      "type": "string"
    },
    "timezone": {
      "default": "UTC",
      "maxLength": 256,
      "minLength": 1,
      "title": "Timezone",
      "type": "string"
    },
    "metric_statuses": {
      "items": {
        "$ref": "#/$defs/MetricAvailability"
      },
      "maxItems": 30,
      "title": "Metric Statuses",
      "type": "array"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/StateObservation"
      },
      "maxItems": 30,
      "title": "Observations",
      "type": "array"
    },
    "limitations": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 30,
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "analysis_id",
    "evidence_revision",
    "algorithm_version",
    "is_simulated",
    "as_of",
    "status"
  ],
  "title": "StateAnalysis",
  "type": "object"
}
